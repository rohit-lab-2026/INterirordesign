# Copy this file to .env and fill in real values. NEVER commit .env or real credentials.
# Atlas -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=Cluster0
DB_NAME=interior-design-booking-site
PORT=5050

# Signs login JWTs (login.html / /api/auth/*). Pick any long random string.
JWT_SECRET=some-long-random-jwt-secret

# Secret for admin-only endpoints (GET /api/users, and accessing another
# user's record via GET/PUT/DELETE /api/users/:id), sent as the x-admin-key
# header. Pick any long random string.
ADMIN_KEY=some-long-random-admin-key

# Also used to sign the express-session cookie that holds the pending OTP
# during registration/login. If unset, JWT_SECRET is reused for this.
SESSION_SECRET=some-long-random-session-secret

# Brevo transactional email (used to send the OTP verification code).
# Get BREVO_API_KEY from https://app.brevo.com/settings/keys/api
# MAIL_FROM_EMAIL must be a sender verified in your Brevo account.
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM_EMAIL=your-verified-sender@example.com
MAIL_FROM_NAME=Nordic Designs
